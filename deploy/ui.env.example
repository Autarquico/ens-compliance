# Copia a deploy/ui.env (modo 600). Solo lo recibe el servicio `ui` (perfil `ui`); no lee deploy/.env.
# Con este fichero presente, box.sh activa el perfil `ui` (docs/runbooks/interfaz-web.md).
# Nombre de host público de la interfaz, sin esquema (p. ej. ui.example.org). Caddy enruta por él.
ENS_UI_HOST=
# Origen público completo (https://<ENS_UI_HOST>). Los POST exigen este Origin.
ENS_UI_ORIGIN=
# AUD de la aplicación de Cloudflare Access (pestaña Overview de la aplicación).
ENS_UI_ACCESS_AUD=
# Dominio del team de Access, sin esquema (p. ej. example.cloudflareaccess.com).
ENS_UI_ACCESS_TEAM_DOMAIN=
# Ruta, dentro del contenedor, del JWKS de Access (p. ej. /data/state/ui/access-jwks.json).
# Sin un fichero válido nadie entra.
ENS_UI_ACCESS_JWKS_FILE=
# Nombre de host público de Backrest (kit de copias), sin esquema (p. ej. copias.example.org). Caddy
# enruta por él; la UI lo lee para el botón «Abrir». Vacío: el perfil copias no se publica.
ENS_COPIAS_HOST=
# Nombre de host público de la interfaz de OpenBao (kit de claves), sin esquema (p. ej. claves.example.org).
# Caddy enruta por él; la UI lo lee para el botón «Abrir». Vacío: el perfil claves no se publica.
ENS_CLAVES_HOST=
# Nombre de host público de Vaultwarden (kit de contraseñas), sin esquema (p. ej. contrasenas.example.org).
# Caddy enruta por él y Vaultwarden lo usa como DOMAIN. Vacío: el perfil contrasenas no se publica.
ENS_CONTRASENAS_HOST=
