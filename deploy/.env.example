# box.sh install lo copia a deploy/.env (modo 600). Nunca lo subas a git.
# Solo lo recibe el servicio `app`. Descomenta y rellena solo lo que uses: una variable vacía
# no equivale a una ausente. En una instalación limpia aún no hay conectores activos y el
# primer ciclo termina con 0. Con conectores activos sin credenciales salen en ERROR en el
# informe (el ciclo termina con 3) y el servicio sigue sano.

# Conectores
# ENS_GITHUB_TOKEN=
# ENS_CLOUDFLARE_API_TOKEN=
# ENS_GOOGLE_SERVICE_ACCOUNT_KEY=

# Workspace en S3-compatible (R2); los nombres los fija el SDK
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=

# Copia restic
# ENS_BACKUP_AWS_ACCESS_KEY_ID=
# ENS_BACKUP_AWS_SECRET_ACCESS_KEY=
# ENS_BACKUP_RESTIC_PASSWORD=

# Avisos por correo del panel de monitorización (docs/runbooks/monitorizacion.md). Solo los lee la
# app; la UI no los recibe. Todo o nada: sin ellos, los avisos son solo web. STARTTLS obligatorio.
# ENS_SMTP_HOST=
# ENS_SMTP_PORT=587
# ENS_SMTP_USER=
# ENS_SMTP_PASSWORD=
# ENS_SMTP_FROM=
# ENS_SMTP_TO=
