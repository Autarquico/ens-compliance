# box.sh install lo copia a deploy/.env (modo 600). Nunca lo subas a git.
# Solo lo recibe el servicio `app`. Descomenta y rellena solo lo que uses: una variable vacía
# no equivale a una ausente. Sin credenciales, los conectores salen en ERROR en el informe
# (el primer ciclo termina con código 3) y el servicio sigue sano.

# Conectores
# ENS_GITHUB_TOKEN=
# ENS_CLOUDFLARE_API_TOKEN=
# ENS_GOOGLE_SERVICE_ACCOUNT_KEY=

# Workspace en S3-compatible (R2); los nombres los fija el SDK
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=

# Copia restic
# ENS_BACKUP_AWS_ACCESS_KEY_ID=
# ENS_BACKUP_AWS_SECRET_ACCESS_KEY=
# ENS_BACKUP_RESTIC_PASSWORD=
