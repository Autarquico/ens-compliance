# Copia a deploy/agent.env (modo 600). Solo lo recibe el servicio `agent` (perfil `agents`).
# Genera cada valor con `openssl rand -base64 32`. Deben ser distintos y de al menos 32 bytes.
# Clave que firma los tokens de alta por equipo (`agent admit`).
ENS_AGENT_ENROLL_KEY=
# Clave que firma los node_key de los equipos ya dados de alta.
ENS_AGENT_NODE_KEY_SECRET=
