{
  "$defs": {
    "CheckStatus": {
      "enum": [
        "PASS",
        "FAIL",
        "ERROR",
        "UNKNOWN"
      ],
      "title": "CheckStatus",
      "type": "string"
    },
    "CollectionStatus": {
      "enum": [
        "SUCCESS",
        "ERROR",
        "PERMISSION_DENIED",
        "NOT_SUPPORTED"
      ],
      "title": "CollectionStatus",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "asset_id": {
      "title": "Asset Id",
      "type": "string"
    },
    "check_id": {
      "title": "Check Id",
      "type": "string"
    },
    "collection_status": {
      "$ref": "#/$defs/CollectionStatus",
      "default": "SUCCESS"
    },
    "evaluated_at": {
      "format": "date-time",
      "title": "Evaluated At",
      "type": "string"
    },
    "evidence_ids": {
      "items": {
        "type": "string"
      },
      "title": "Evidence Ids",
      "type": "array"
    },
    "reason": {
      "title": "Reason",
      "type": "string"
    },
    "reason_code": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Reason Code"
    },
    "status": {
      "$ref": "#/$defs/CheckStatus"
    },
    "subject": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Subject"
    }
  },
  "required": [
    "check_id",
    "asset_id",
    "status",
    "evaluated_at",
    "reason"
  ],
  "title": "CheckResult",
  "type": "object"
}
