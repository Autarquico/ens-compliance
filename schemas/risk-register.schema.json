          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "impact": {
          "minLength": 1,
          "title": "Impact",
          "type": "string"
        },
        "inherent": {
          "minLength": 1,
          "title": "Inherent",
          "type": "string"
        },
        "likelihood": {
          "minLength": 1,
          "title": "Likelihood",
          "type": "string"
        },
        "owner": {
          "title": "Owner",
          "type": "string"
        },
        "residual": {
          "minLength": 1,
          "title": "Residual",
          "type": "string"
        },
        "safeguards": {
          "items": {
            "type": "string"
          },
          "title": "Safeguards",
          "type": "array"
        },
        "services": {
          "items": {
            "type": "string"
          },
          "title": "Services",
          "type": "array"
        },
        "threat": {
          "title": "Threat",
          "type": "string"
        },
        "treatment": {
          "$ref": "#/$defs/Treatment"
