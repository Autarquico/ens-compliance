{
  "$defs": {
    "Blocker": {
      "additionalProperties": false,
      "properties": {
        "detail": {
          "default": "",
          "title": "Detail",
          "type": "string"
        },
        "kind": {
          "$ref": "#/$defs/BlockerKind"
        },
        "measure_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Measure Id"
        }
      },
      "required": [
        "kind"
      ],
      "title": "Blocker",
      "type": "object"
    },
    "BlockerKind": {
      "enum": [
        "UNDETERMINED_APPLICABILITY",
        "NOT_APPLICABLE_WITHOUT_JUSTIFICATION",
        "MISSING_EVIDENCE",
        "EXPIRED_EVIDENCE",
        "MISSING_REVIEW",
        "EXPIRED_REVIEW",
        "NOT_COMPLIANT",
        "OPEN_FINDING"
      ],
      "title": "BlockerKind",
      "type": "string"
    },
    "Category": {
      "enum": [
        "BASICA",
        "MEDIA",
        "ALTA"
      ],
      "title": "Category",
      "type": "string"
    },
    "CorrectiveMeasure": {
      "additionalProperties": false,
      "properties": {
        "addressee": {
          "$ref": "#/$defs/Role"
        },
        "description": {
          "title": "Description",
          "type": "string"
        }
      },
      "required": [
        "description",
        "addressee"
      ],
      "title": "CorrectiveMeasure",
      "type": "object"
    },
    "DossierState": {
      "enum": [
        "GENERATED",
        "SELF_ASSESSED",
        "ANALYZED",
        "DECLARED"
      ],
      "title": "DossierState",
      "type": "string"
    },
    "Readiness": {
      "enum": [
        "READY",
        "NOT_READY"
      ],
      "title": "Readiness",
      "type": "string"
    },
    "ReadinessResult": {
      "additionalProperties": false,
      "properties": {
        "blockers": {
          "items": {
            "$ref": "#/$defs/Blocker"
          },
          "title": "Blockers",
          "type": "array"
        },
        "pending_human_review": {
          "title": "Pending Human Review",
          "type": "boolean"
        },
        "readiness": {
          "$ref": "#/$defs/Readiness"
        }
      },
      "required": [
        "readiness",
        "blockers",
        "pending_human_review"
      ],
      "title": "ReadinessResult",
      "type": "object"
    },
    "Role": {
      "enum": [
        "system_administrator",
        "system_administrator_delegate",
        "security_officer",
        "system_owner",
        "management"
      ],
      "title": "Role",
      "type": "string"
    },
    "Transition": {
      "additionalProperties": false,
      "properties": {
        "actor": {
          "title": "Actor",
          "type": "string"
        },
        "at": {
          "format": "date-time",
          "title": "At",
          "type": "string"
        },
        "conclusions": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Conclusions"
        },
        "corrective_measures": {
          "items": {
            "$ref": "#/$defs/CorrectiveMeasure"
          },
          "title": "Corrective Measures",
          "type": "array"
        },
        "dossier_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Dossier Sha256",
          "type": "string"
        },
        "from_state": {
          "$ref": "#/$defs/DossierState"
        },
        "manual_judgment_review": {
          "default": false,
          "title": "Manual Judgment Review",
          "type": "boolean"
        },
        "readiness": {
          "anyOf": [
            {
              "$ref": "#/$defs/ReadinessResult"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "role": {
          "$ref": "#/$defs/Role"
        },
        "to_state": {
          "$ref": "#/$defs/DossierState"
        }
      },
      "required": [
        "from_state",
        "to_state",
        "actor",
        "role",
        "at",
        "dossier_sha256"
      ],
      "title": "Transition",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "category": {
      "$ref": "#/$defs/Category"
    },
    "state": {
      "$ref": "#/$defs/DossierState",
      "default": "GENERATED"
    },
    "transitions": {
      "items": {
        "$ref": "#/$defs/Transition"
      },
      "title": "Transitions",
      "type": "array"
    }
  },
  "required": [
    "category"
  ],
  "title": "Dossier",
  "type": "object"
}
