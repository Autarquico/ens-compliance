        "$ref": "#/$defs/Dimension"
      },
      "minItems": 1,
      "title": "Dimensions",
      "type": "array"
    },
    "group": {
      "$ref": "#/$defs/Group"
    },
    "id": {
      "title": "Id",
      "type": "string"
    },
    "levels": {
      "additionalProperties": {
        "$ref": "#/$defs/LevelRequirement"
      },
      "title": "Levels",
      "type": "object"
    },
    "name": {
      "title": "Name",
      "type": "string"
    },
    "notes": {
      "description": "Divergencias del propio anexo aceptadas al extraer.",
      "items": {
        "type": "string"
      },
      "title": "Notes",
      "type": "array"
    },
    "preamble": {
      "items": {
        "type": "string"
      },
      "title": "Preamble",
      "type": "array"
    },
    "reinforcements": {
      "items": {
        "$ref": "#/$defs/Reinforcement"
      },
      "title": "Reinforcements",
      "type": "array"
    },
    "source": {
      "$ref": "#/$defs/Source"
    },
    "subgroup": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "description": "p. ej. `op.pl`; None en el marco organizativo.",
      "title": "Subgroup"
    }
  },
  "required": [
    "id",
    "name",
    "group",
    "subgroup",
    "applies_by",
    "dimensions",
    "base",
    "levels",
