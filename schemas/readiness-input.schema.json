{
  "$defs": {
    "Applicability": {
      "enum": [
        "APPLICABLE",
        "NOT_APPLICABLE",
        "UNDETERMINED"
      ],
      "title": "Applicability",
      "type": "string"
    },
    "EvidenceRef": {
      "additionalProperties": false,
      "properties": {
        "collected_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Collected At"
        },
        "id": {
          "title": "Id",
          "type": "string"
        },
        "valid_until": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Valid Until"
        }
      },
      "required": [
        "id"
      ],
      "title": "EvidenceRef",
      "type": "object"
    },
    "Measure": {
      "additionalProperties": false,
      "properties": {
        "applicability": {
          "$ref": "#/$defs/Applicability"
        },
        "assessment": {
          "$ref": "#/$defs/MeasureAssessment",
          "default": "NOT_ASSESSED"
        },
        "evidence": {
          "items": {
            "$ref": "#/$defs/EvidenceRef"
          },
          "title": "Evidence",
          "type": "array"
        },
        "id": {
          "title": "Id",
          "type": "string"
        },
        "justification": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Justification"
        },
        "review": {
          "anyOf": [
            {
              "$ref": "#/$defs/Review"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "id",
        "applicability"
      ],
      "title": "Measure",
      "type": "object"
    },
    "MeasureAssessment": {
      "enum": [
        "COMPLIANT",
        "NON_COMPLIANT",
        "REQUIRES_REVIEW",
        "NOT_ASSESSED"
      ],
      "title": "MeasureAssessment",
      "type": "string"
    },
    "OpenFinding": {
      "additionalProperties": false,
      "properties": {
        "description": {
          "default": "",
          "title": "Description",
          "type": "string"
        },
        "id": {
          "title": "Id",
          "type": "string"
        }
      },
      "required": [
        "id"
      ],
      "title": "OpenFinding",
      "type": "object"
    },
    "Review": {
      "additionalProperties": false,
      "properties": {
        "conclusion": {
          "title": "Conclusion",
          "type": "string"
        },
        "evidence_ids": {
          "items": {
            "type": "string"
          },
          "title": "Evidence Ids",
          "type": "array"
        },
        "reviewed_at": {
          "format": "date-time",
          "title": "Reviewed At",
          "type": "string"
        },
        "reviewer": {
          "title": "Reviewer",
          "type": "string"
        },
        "role": {
          "$ref": "#/$defs/Role"
        },
        "valid_until": {
          "format": "date-time",
          "title": "Valid Until",
          "type": "string"
        }
      },
      "required": [
        "reviewer",
        "role",
        "reviewed_at",
        "valid_until",
        "conclusion"
      ],
      "title": "Review",
      "type": "object"
    },
    "Role": {
      "enum": [
        "system_administrator",
        "system_administrator_delegate",
        "security_officer",
        "system_owner"
      ],
      "title": "Role",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "evaluated_at": {
      "format": "date-time",
      "title": "Evaluated At",
      "type": "string"
    },
    "judgment_executed": {
      "title": "Judgment Executed",
      "type": "boolean"
    },
    "measures": {
      "items": {
        "$ref": "#/$defs/Measure"
      },
      "minItems": 1,
      "title": "Measures",
      "type": "array"
    },
    "open_findings": {
      "items": {
        "$ref": "#/$defs/OpenFinding"
      },
      "title": "Open Findings",
      "type": "array"
    }
  },
  "required": [
    "measures",
    "judgment_executed",
    "evaluated_at"
  ],
  "title": "ReadinessInput",
  "type": "object"
}
