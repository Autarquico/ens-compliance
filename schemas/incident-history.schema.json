{
  "$defs": {
    "HistoryEntry": {
      "additionalProperties": false,
      "properties": {
        "evidence_id": {
          "title": "Evidence Id",
          "type": "string"
        },
        "key": {
          "title": "Key",
          "type": "string"
        },
        "seq": {
          "minimum": 1,
          "title": "Seq",
          "type": "integer"
        },
        "sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Sha256",
          "type": "string"
        }
      },
      "required": [
        "seq",
        "key",
        "sha256",
        "evidence_id"
      ],
      "title": "HistoryEntry",
      "type": "object"
    },
    "IncidentStatus": {
      "enum": [
        "open",
        "closed"
      ],
      "title": "IncidentStatus",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "final_status": {
      "$ref": "#/$defs/IncidentStatus"
    },
    "incident_id": {
      "title": "Incident Id",
      "type": "string"
    },
    "records": {
      "items": {
        "$ref": "#/$defs/HistoryEntry"
      },
      "minItems": 1,
      "title": "Records",
      "type": "array"
    },
    "schema_version": {
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "simulated": {
      "title": "Simulated",
      "type": "boolean"
    }
  },
  "required": [
    "incident_id",
    "simulated",
    "final_status",
    "records"
  ],
  "title": "IncidentHistory",
  "type": "object"
}
